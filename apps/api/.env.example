# Copy to .env for local development. NEVER commit .env. Real values live in host secret stores
# (Render / GitHub secrets). This file lists variable NAMES with safe local defaults only.

APP_ENV=development                 # development | test | production
PROJECT_NAME="Product Factory API"
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# Comma-separated browser origins allowed to call the API. Production must be explicit https URLs.
FRONTEND_ORIGINS=http://localhost:3000

RATE_LIMIT_DEFAULT=120/minute
# Shared rate-limit storage across workers (recommended in production). Empty = in-memory.
REDIS_URL=

# Leave empty: API docs on outside production, off in production. Set true/false to override.
DOCS_ENABLED=

# Database. Local default matches infra/docker-compose.yml. In production use the Supabase connection
# string; postgresql:// is accepted and converted automatically.
DATABASE_URL=postgresql+psycopg://factory:factory@localhost:5432/factory
# Direct (non-pooled) connection used only by migrations. Leave empty to reuse DATABASE_URL.
MIGRATION_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# true when DATABASE_URL is a transaction pooler (Supabase port 6543).
DB_POOLER=false

# Login (Supabase Auth). Each product has its own project; the Factory itself has none.
# Leave empty locally: protected routes then answer 503 "login not configured".
SUPABASE_URL=
AUTH_AUDIENCE=authenticated
# Defaults to <SUPABASE_URL>/auth/v1. Override only if a real token shows a different issuer.
AUTH_ISSUER=
AUTH_JWKS_CACHE_SECONDS=600

# Folder containing roles.config.json (defaults to the repo's product/ folder; the Docker image sets it).
PRODUCT_CONFIG_DIR=
